{
  "manifest_version": 3,
  "name": "OpenEMR Voice Capture",
  "version": "0.2.0",
  "description": "Dictate into OpenEMR encounter forms. Local speech-to-text with clinical analysis; every field is confirmed before it is written.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "all_frames": true,
      "js": [
        "scanner.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OpenEMR Voice Capture"
  }
}
